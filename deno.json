{
   "name": "@sholvoir/components",
   "version": "0.1.0",
   "lock": false,
   "tasks": {
      "build": "deno -A main.ts build",
      "release": "deno -A main.ts release",
      "start": "deno -A main.ts start"
   },
   "lint": { "rules": { "tags": ["recommended"] } },
   "imports": {
      "@preact/signals": "npm:@preact/signals@^2.0.1",
      "@std/fs": "jsr:@std/fs@^1.0.13",
      "esbuild": "npm:esbuild@^0.25.0",
      "esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
      "preact": "npm:preact@^10.25.4"
   },
   "compilerOptions": {
      "jsx": "react-jsx",
      "jsxImportSource": "preact"
   },
   "publish": {
      "include": [
         "src/**/*.tsx",
         "lib/**/*.ts"
      ]
   },
   "exports": {
      "./button-base": "./src/button-base.tsx",
      "./button-ripple": "./src/button-ripple.tsx",
      "./checkbox": "./src/checkbox.tsx",
      "./icon-check": "./src/icon-check.tsx",
      "./input-text": "./src/input-text.tsx",
      "./input-textarea": "./src/input-textarea.tsx",
      "./select-multi": "./src/select-multi.tsx",
      "./select-single": "./src/select-single.tsx",
      "./options": "./lib/options.ts"
   }
}