{
   "name": "@sholvoir/components",
   "version": "0.1.1",
   "lock": false,
   "tasks": {
      "build": "deno -A main.ts build",
      "release": "deno -A main.ts release",
      "start": "deno -A main.ts start"
   },
   "lint": { "rules": { "tags": ["recommended"] } },
   "imports": {
      "@iconify/tailwind4": "npm:@iconify/tailwind4@^1.0.3",
      "@preact/signals": "npm:@preact/signals@^2.0.1",
      "@std/fs": "jsr:@std/fs@^1.0.13",
      "esbuild": "npm:esbuild@^0.25.0",
      "esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
      "unocss": "npm:unocss@^66.0.0",
      "preact": "npm:preact@^10.25.4"
   },
   "compilerOptions": {
      "jsx": "react-jsx",
      "jsxImportSource": "preact"
   },
   "exports": {
      "./src/button-base": "./src/button-base.tsx",
      "./src/button-ripple": "./src/button-ripple.tsx",
      "./src/checkbox": "./src/checkbox.tsx",
      "./src/dropdown": "./src/dropdown.tsx",
      "./src/icon-check": "./src/icon-check.tsx",
      "./src/icon-chevron-down": "./src/icon-chevron-down.tsx",
      "./src/icon-chevron-left": "./src/icon-chevron-left.tsx",
      "./src/icon-refresh": "./src/icon-refresh.tsx",
      "./src/input-text": "./src/input-text.tsx",
      "./src/input-textarea": "./src/input-textarea.tsx",
      "./src/list": "./src/list.tsx",
      "./src/select-multi": "./src/select-multi.tsx",
      "./src/select-single": "./src/select-single.tsx",
      "./src/tab": "./src/tab.tsx",
      "./lib/animation-ripple": "./lib/animation-ripple.ts",
      "./lib/country-code": "./lib/country-code.ts",
      "./lib/options": "./lib/options.ts",
      "./lib/tailwind-preflight": "./lib/tailwind-preflight.ts"
   }
}